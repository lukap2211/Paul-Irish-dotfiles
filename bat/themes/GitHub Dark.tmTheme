			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79c0ff</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Property / key</string>
			<key>scope</key>
			<string>support.type.property-name, meta.object-literal.key, entity.name.tag.yaml, keyword.other.definition.ini</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79c0ff</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
