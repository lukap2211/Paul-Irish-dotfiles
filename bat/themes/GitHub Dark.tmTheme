			<key>name</key>
			<string>Shell variable</string>
			<key>scope</key>
			<string>variable.other.normal.shell, punctuation.definition.variable.shell</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffa657</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
