<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GitHub dark (Primer palette), same colours as eza/themes/github-dark.yml -->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>GitHub Dark</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#e6edf3</string>
				<key>background</key>
				<string>#0d1117</string>
				<key>caret</key>
				<string>#e6edf3</string>
				<key>lineHighlight</key>
				<string>#161b22</string>
				<key>selection</key>
				<string>#264f78</string>
				<key>gutter</key>
				<string>#0d1117</string>
				<key>gutterForeground</key>
				<string>#6e7681</string>
				<key>invisibles</key>
				<string>#484f58</string>
				<key>guide</key>
				<string>#21262d</string>
				<key>findHighlight</key>
				<string>#e3b341</string>
				<key>findHighlightForeground</key>
				<string>#0d1117</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#8b949e</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Keyword</string>
			<key>scope</key>
			<string>keyword, storage, storage.type, keyword.operator.new, keyword.control</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff7b72</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Operator</string>
			<key>scope</key>
			<string>keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff7b72</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>String</string>
			<key>scope</key>
			<string>string, punctuation.definition.string</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#a5d6ff</string>
			</dict>
		</dict>
