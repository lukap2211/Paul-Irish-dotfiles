# copy to ~/.ssh/config (chmod 600). work-specific hosts live in the gitignored work/ssh.config.example
# ssh keeps the first value it finds for each option, so specific hosts go first and Host * last

# github.com and gitlab.com aren't here: git reaches them over https (see .gitconfig)

Host *
	AddKeysToAgent yes
	UseKeychain yes
	IdentitiesOnly yes
	StrictHostKeyChecking accept-new
	UserKnownHostsFile ~/.ssh/known_hosts
