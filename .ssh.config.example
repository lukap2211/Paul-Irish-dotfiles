# laid out the way work-bootstrap wants it (its check needs ~/.ssh/config to start with the Include):
#   ~/.ssh/config                            the bootstrap's header below, nothing else
#   ~/.ssh/config.d/0_bootstrap_owned.config generated by the bootstrap: workgit, remote-access, work defaults
#   ~/.ssh/config.d/10_custom.config         mine, the rest of this file
# included files load in name order and ssh keeps the first value it finds, so the bootstrap's settings win
# (e.g. no host key checking anywhere); 10_custom.config can only add options it doesn't set.
# files chmod 600, config.d 700, all owned by me (not root, or ssh and the bootstrap check can't read them)

# ----- ~/.ssh/config -----
Include config.d/*

# To specify custom config, please create a new file in ~/.ssh/config.d
# This file (~/.ssh/config) always needs to have `Include config.d/*` as the first line

# ----- ~/.ssh/config.d/10_custom.config -----
# the bootstrap's workgit stanza already matches
# https://work.example.com/workgit/get-started/fragments/vpn-macos-git (key ~/.ssh/workgit/id_ed25519,
# User git, no host key checking). this only adds: skip the agent, the key has no passphrase and a stuck agent hangs git
Host workgit work.example.com
	IdentityAgent none

Host *
	UseKeychain yes
