# shortcuts for common commands
[alias]
	b = branch
	c = commit -am
	s = status
	co = checkout
	cp = cherry-pick
	cherrypick = cherry-pick
	amend = commit --amend --all
	fpush = push --force
	sclone = clone --depth=1
	undocommit = reset HEAD~
	hreset = reset --hard
	df = diff --color --color-words --abbrev
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	# Local branches, oldest first, with how long ago they were last touched
	wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads
	# Show the diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"
	reup = rebase-update # depot_tools specific
	git = !exec git

# global ignore/attributes files, pager and commit message editor
[core]
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
	pager = diff-so-fancy | less --tabs=4 -RFX
	editor = vim

# insanely beautiful diffs (diff-so-fancy is installed via the Brewfile)
[pager]
	diff = diff-so-fancy | less --tabs=4 -RFX
	show = diff-so-fancy | less --tabs=4 -RFX

# disabled until github.com/so-fancy/diff-so-fancy/pull/172 is resolved :(
[interactive]
	# diffFilter = "diff-so-fancy"

# so much color
[color]
	ui = auto

# diff colours, including moved lines (see [diff] colorMoved)
[color "diff"]
	meta = yellow bold
	commit = green bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
	newMoved = cyan
	oldMoved = blue

# word-level highlight colours used by diff-so-fancy
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22

# git branch colours
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

# git status colours
[color "status"]
	added = yellow
	changed = green
	untracked = cyan

# colour blame metadata by age, with relative dates
[blame]
	coloring = highlightRecent
	date = relative

# blame age colours: old = dim grey ... last week = green (github dark palette)
[color "blame"]
	highlightRecent = 243, 18 month ago, 246, 6 month ago, 252, 1 month ago, 111, 1 week ago, 114

# Show blocks of moved text of at least 20 alphanumeric characters differently than adds/deletes
# https://blog.github.com/2018-04-05-git-217-released/
[diff]
	colorMoved = zebra

# git mergetool, no rename detection limit, fast-forward merges only
[merge]
	tool = opendiff
	renameLimit = 0
	ff = only

# delete local refs to branches removed on the remote
[fetch]
	prune = true

# rebase instead of merge on pull
[pull]
	rebase = true

# new branches rebase on pull too
[branch]
	autosetuprebase = always

# show the full diff in git stash show
[stash]
	showPatch = true

# correct typos
[help]
	autocorrect = 1

# default branch name for git init
[init]
	defaultBranch = main

# git lfs hooks
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

######################################################################
### credentials and URL rewrites

# github.com uses gh below; anything else (e.g. gitlab tokens) goes in the macOS keychain
[credential]
	helper = osxkeychain

# github.com auth via `gh auth login -h github.com`
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

# rewrite github ssh-style addresses to https
[url "https://github.com/"]
	insteadOf = github.com:
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

######################################################################
### identity

[user]
	name = Luka Puharic

# work-only settings (default email, proxies, work git host), gitignored in work/ and linked by symlink-setup.sh.
# skipped if it doesn't exist
[include]
	path = ~/.gitconfig.work

# personal identity / github token / etc for repos under ~/GitHub, overrides the work settings above
[includeIf "gitdir:~/GitHub/"]
	path = ~/.gitconfig.local
