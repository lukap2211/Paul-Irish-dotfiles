font-family = "Monaco"
font-size = 12
# font-thicken = true
theme = "iTerm2 Default"
macos-icon = retro
bold-is-bright = true

# Contrast tweaks for git colors (see ~/.gitconfig)
palette = 1=#e8331c
palette = 4=#5060ff
palette = 52=#781010
palette = 22=#0b6416

# search highlight like iTerm (lukap profile): yellow matches, the current match looks like a selection
search-foreground = #000000
search-background = #fffb00
search-selected-foreground = #000000
search-selected-background = #b5d5ff

# copy selections (double-click word, triple-click line, drag) to the system clipboard too
copy-on-select = clipboard

# search navigation: cmd+g / cmd+shift+g for next / previous match
keybind = super+g=navigate_search:next
keybind = super+shift+g=navigate_search:previous

# let cmd+v paste into the search bar: only consume it when the terminal can paste
keybind = super+v=paste_from_clipboard
